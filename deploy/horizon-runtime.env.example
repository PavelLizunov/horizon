# Non-secret environment consumed by horizon-digest.service.
# Install as /etc/horizon/runtime.env and keep deployment values local.
# API/webhook credentials remain in the gitignored /opt/horizon/.env (mode 0600).

HORIZON_DIR=/opt/horizon
HORIZON_HOURS=24
HORIZON_SITE_HOST=horizon-ingress
HORIZON_SITE_PATH=/srv/digest.example.com

# Linux production intentionally skips the optional local narration interpreter.
HORIZON_TTS_PYTHON=/nonexistent
