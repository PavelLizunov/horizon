<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS launchd template: run Horizon once a day.

  Before installing, replace every YOURUSER with the macOS account name that
  owns the checkout (e.g. sed -i '' 's/YOURUSER/yourname/g' this-file), adjust
  Hour/Minute to your off-peak token window if you pay per-token, then:

    cp this-file ~/Library/LaunchAgents/com.horizon.digest.plist
    launchctl load ~/Library/LaunchAgents/com.horizon.digest.plist

  See deploy/README.md for the full walkthrough.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.horizon.digest</string>
  <key>ProgramArguments</key>
  <array>
    <!-- run-daily.sh, not `horizon` directly: the pipeline publishes markdown
         but the site still has to be built and shipped. Scheduling only the
         first step sent Telegram links to pages that did not exist. -->
    <string>/Users/YOURUSER/horizon/deploy/run-daily.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/YOURUSER/horizon</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/YOURUSER/bin:/Users/YOURUSER/node/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <!-- Pin the whisper model cache (~2 GB). Without this it follows
         XDG_CACHE_HOME, so adding that variable later would silently move the
         cache and re-download the model on the next scheduled run. -->
    <key>HF_HOME</key>
    <string>/Users/YOURUSER/.cache/huggingface</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>17</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/YOURUSER/horizon/logs/horizon.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOURUSER/horizon/logs/horizon.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
