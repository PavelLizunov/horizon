<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS launchd template: run Horizon once a day.

  Before installing, replace every YOURUSER with the macOS account name that
  owns the checkout (e.g. sed -i '' 's/YOURUSER/yourname/g' this-file), adjust
  Hour/Minute to your off-peak token window if you pay per-token, then:

    cp this-file ~/Library/LaunchAgents/com.horizon.digest.plist
    launchctl load ~/Library/LaunchAgents/com.horizon.digest.plist

  See deploy/README.md for the full walkthrough.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.horizon.digest</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOURUSER/horizon/.venv/bin/horizon</string>
    <string>--hours</string>
    <string>24</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/YOURUSER/horizon</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/YOURUSER/bin:/Users/YOURUSER/node/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>17</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/YOURUSER/horizon/logs/horizon.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOURUSER/horizon/logs/horizon.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
